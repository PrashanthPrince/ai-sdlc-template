{
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git checkout -b feature/*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push origin feature/*)",
      "Bash(gh pr create --draft:*)", "Bash(gh pr view:*)", "Bash(gh pr diff:*)",
      "Bash(npm run lint)", "Bash(npm test:*)", "Bash(npx playwright test:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)", "Read(**/*.pem)", "Read(**/*.key)",
      "Bash(git push --force:*)", "Bash(git push origin main)", "Bash(git push origin develop)",
      "Bash(rm -rf:*)", "Bash(curl:*)", "Bash(wget:*)",
      "Bash(gh pr merge:*)", "Bash(gh pr review --approve:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-paths.sh" } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" } ] }
    ]
  }
}
